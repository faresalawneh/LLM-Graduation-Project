# NVML exporter for WSL2/laptop. No CUDA toolkit: in WSL2 the driver libs
# (libnvidia-ml.so) are bind-mounted from the host by the NVIDIA container
# runtime (NVIDIA_DRIVER_CAPABILITIES=utility).
FROM python:3.12-slim

WORKDIR /app
# The exporter imports only pynvml and prometheus_client, so install just those
# (same pins as the root requirements.txt, which CI uses to run its tests).
RUN pip install --no-cache-dir nvidia-ml-py==12.575.51 prometheus_client==0.23.1
COPY monitoring/exporters/nvml_exporter.py .

EXPOSE 9400
CMD ["python", "nvml_exporter.py"]

