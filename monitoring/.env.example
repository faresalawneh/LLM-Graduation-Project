# Copy to monitoring/.env before starting the stack:
#   cp monitoring/.env.example monitoring/.env
#
# Every image is pinned to an exact version so the stack is reproducible.
# Never use :latest for VLLM_IMAGE: newer vLLM builds fail on the RTX 5060
# (Blackwell) under WSL2, and stack_up.sh refuses to start with :latest.

# Inference server
VLLM_IMAGE=vllm/vllm-openai:v0.6.3

# Monitoring
PROMETHEUS_IMAGE=prom/prometheus:v3.16.0
GRAFANA_IMAGE=grafana/grafana:13.3.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.116.1

# Grafana admin password (user "admin"). Required: compose will not start
# Grafana without it. Only applied when the grafana_data volume is first created.
GRAFANA_ADMIN_PASSWORD=

# Demo environment only (docker-compose.demo.yml). Dev ignores both.
# Docker Hub account CI pushes to (the DOCKERHUB_USERNAME repo secret).
DOCKERHUB_NAMESPACE=mahmoudalwaqfi
# Commit SHA of the CI run on main that published the images to Docker Hub.
# Set it to the full SHA of the gp2-demo tag before starting the demo.
# Left empty, the demo compose refuses to start.
DEMO_IMAGE_TAG=
