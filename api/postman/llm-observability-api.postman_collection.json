{
  "info": {
    "_postman_id": "e9ec215d-15dd-504d-a81c-096945e7ac6e",
    "name": "LLM Observability API",
    "description": "End-to-end tests for the FastAPI service in `api/` (REQ-03, issue #25).\n\nSelect the **LLM Observability API - local** environment and run the whole collection in order (Collection Runner, or `newman run`). Folder 1 logs in as `admin` and `viewer` and stores both JWTs; later folders reuse them. Metric values are `null` when Prometheus is not reachable; the tests check status codes, field names and RBAC, not values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Run first: the other folders use the tokens saved here.",
      "item": [
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns a bearer token\", () => {",
                  "    pm.expect(body.token_type).to.eql(\"bearer\");",
                  "    pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"Role is admin\", () => pm.expect(body.role).to.eql(\"admin\"));",
                  "pm.collectionVariables.set(\"adminToken\", body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "description": "OAuth2 password flow. Saves the JWT to the `adminToken` collection variable.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{adminUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Login as viewer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns a bearer token\", () => {",
                  "    pm.expect(body.token_type).to.eql(\"bearer\");",
                  "    pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"Role is viewer\", () => pm.expect(body.role).to.eql(\"viewer\"));",
                  "pm.collectionVariables.set(\"viewerToken\", body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "description": "OAuth2 password flow. Saves the JWT to the `viewerToken` collection variable.",
            "body": {
