# Copy to api/.env (gitignored) and fill in. Read by auth.py when you run
# `python app.py` on the host, and by api/docker-compose.yml.
#
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# One account per role; the username is the role name (admin, viewer).
# Leave a password empty to disable that account.
API_ADMIN_PASSWORD=
API_VIEWER_PASSWORD=

# Optional. Token lifetime in minutes.
JWT_EXPIRE_MINUTES=60
