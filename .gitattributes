# Auto detect text files and perform LF normalization
* text=auto
*.csv filter=lfs diff=lfs merge=lfs -text
*.sh text eol=lf
*.py text eol=lf
*.jsonl filter=lfs diff=lfs merge=lfs -text
inputs.json filter=lfs diff=lfs merge=lfs -text
*_timeslices.json filter=lfs diff=lfs merge=lfs -text
server_metrics_export.json filter=lfs diff=lfs merge=lfs -text

# GP1 replay results are already committed as plain text and are small
# (928K / 8K). Keep them out of LFS - the *.jsonl rule above targets
# large future exports, not these.
replay_results/**/*.jsonl  -filter -diff -merge
